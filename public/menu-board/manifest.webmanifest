{
  "id": "/menu-board/",
  "name": "Big Papa's Menu Board",
  "short_name": "Papa's Menu",
  "description": "The live digital menu board for Big Papa's Texas Loaded Potatoes.",
  "start_url": "/menu-board/?source=installed",
  "scope": "/menu-board/",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#171412",
  "theme_color": "#171412",
  "icons": [
    {
      "src": "/images/menu-board-icon-192.webp",
      "sizes": "192x192",
      "type": "image/webp",
      "purpose": "any maskable"
    },
    {
      "src": "/images/menu-board-icon-512.webp",
      "sizes": "512x512",
      "type": "image/webp",
      "purpose": "any maskable"
    }
  ]
}
