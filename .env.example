# Keep this value private. Copy the calendar's "Secret address in iCal format"
# from Google Calendar settings and store it in Netlify using this variable name.
GOOGLE_CALENDAR_ICS_URL=

# Existing shared staff password used by the live-location updater and menu studio.
# Use at least 12 characters and keep it in Netlify's Functions scope.
LOCATION_ADMIN_PASSWORD=

# Facebook Page automation. Keep the access token private and Functions-scoped.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Optional comma-separated HTTPS image URLs for rotating calendar announcements.
# Leave empty to use the three branded images bundled with the site.
FACEBOOK_EVENT_IMAGE_URLS=
